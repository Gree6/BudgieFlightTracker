<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- In res/values/styles.xml -->
    <style name="BudgeySearchBar" parent="Theme.AppCompat.Light">
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>

        <item name="android:textColorHint">@color/grey_text_dark_borders</item>

        <item name="android:popupBackground">@color/surface</item>

        <item name="android:dropDownItemStyle">@style/BudgeySearchDropDownItemStyle</item>

        <item name="iconifiedByDefault">false</item>
    </style>


    <style name="BudgeyFilterSearch" parent="Theme.AppCompat.Light">
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>

        <item name="android:textColorHint">@color/grey_text_dark_borders</item>

        <item name="android:popupBackground">@color/surface</item>

        <item name="android:dropDownItemStyle">@style/BudgeySearchDropDownItemStyle</item>

        <item name="iconifiedByDefault">false</item>
    </style>

    <style name="BudgeySearchDropDownItemStyle" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="BudgeyFilterSpinner" parent="Theme.AppCompat.Light">
        <item name="textFillColor">@color/black</item>
        <item name="searchIcon">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:iconTint" tools:targetApi="26">@color/black</item>
        <item name="android:textAppearance">@color/black</item>
        <item name="android:background">@color/light_primary</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="hintTextAppearance">@color/black</item>
        <item name="android:hint">@color/black</item>
        <item name="android:popupBackground">@color/black</item>
        <item name="android:completionHintView">@color/black</item>
        <item name="android:queryHint">Search destination</item>
        <item name="android:cacheColorHint">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="closeIconTint">@color/black</item>
        <item name="queryBackground">@color/light_primary</item>
        <item name="submitBackground">@color/light_primary</item>
        <item name="iconifiedByDefault">false</item>
        <item name="simpleItemSelectedColor">@color/black</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="colorButtonNormal">@color/black</item>
        <item name="colorSwitchThumbNormal">@color/black</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorBackgroundFloating">@color/black</item>
    </style>

</resources>